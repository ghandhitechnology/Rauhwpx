{
  "name": "@rauhwpx/cloud",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.7.0"
  },
  "dependencies": {
    "puppeteer-core": "25.6.0"
  },
  "scripts": {
    "start": "node src/main.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "for f in src/*.mjs document-runtime/*.mjs worker/*.mjs install/*.mjs; do node --check \"$f\" || exit 1; done",
    "smoke:studio": "node document-runtime/smoke.mjs"
  }
}
