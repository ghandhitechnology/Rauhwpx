# 앱이 제공하는 샌드박스 이미지. 중첩 컨테이너를 만들 수 없는 호스트에서 돌기 때문에
# 컨트롤 플레인과 세션 워커가 한 컨테이너를 공유하고, 워커만 전용 uid로 내려간다.
FROM node:24-bookworm-slim@sha256:3638d9a6fe4030bd716be989438248074489337ba3275657f93595428be4fc03

ARG CHROMIUM_VERSION=151.0.7922.173-1~deb12u1
ARG FFMPEG_VERSION=7:5.1.9-0+deb12u1
ARG TINI_VERSION=0.19.0-1+b3
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    chromium="$CHROMIUM_VERSION" \
    curl \
    ffmpeg="$FFMPEG_VERSION" \
    fonts-noto-cjk \
    matchbox-window-manager \
    tini="$TINI_VERSION" \
    x11-apps \
    x11-utils \
    xauth \
    xvfb \
  && ffmpeg -hide_banner -devices 2>&1 | grep -q 'x11grab' \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/rauhwpx-provider-cli
COPY install/provider-runtime/package.json install/provider-runtime/package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund \
  && ./node_modules/.bin/claude --version \
  && ./node_modules/.bin/codex --version \
  && ./node_modules/.bin/grok --version \
  && ./node_modules/.bin/pi --version

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund

COPY runtime-assets/rhwp-agent/package.json runtime-assets/rhwp-agent/package-lock.json /app/rhwp-agent/
RUN npm --prefix /app/rhwp-agent ci --omit=dev --ignore-scripts --no-audit --no-fund
COPY runtime-assets/studio /app/studio
COPY runtime-assets/rhwp-agent /app/rhwp-agent
COPY runtime-assets/bin/rhwp /app/bin/rhwp
COPY worker /app/worker
COPY document-runtime /app/document-runtime
COPY src /app/src
COPY migrations /app/migrations
COPY bin /app/bin
COPY install/providers.lock.json /app/install/providers.lock.json
COPY install/provider-runtime /app/install/provider-runtime
COPY install/sandbox-entrypoint.sh /app/install/sandbox-entrypoint.sh

RUN groupadd --system --gid 1001 rauhwpx-worker \
  && useradd --system --uid 1001 --gid 1001 --no-create-home rauhwpx-worker \
  && mkdir -p /run/rauhwpx /var/lib/rauhwpx-cloud /var/lib/rauhwpx-workspaces /opt/rauhwpx-cloud/provider-cli \
  && chmod 0711 /run/rauhwpx /var/lib/rauhwpx-workspaces \
  && chmod 0755 /opt/rauhwpx-cloud/provider-cli \
  && chmod 0755 /app/bin/rhwp /app/install/sandbox-entrypoint.sh \
  && /app/bin/rhwp --version

ENV PATH=/app/bin:/opt/rauhwpx-provider-cli/node_modules/.bin:/usr/local/bin:/usr/bin:/bin \
    PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium \
    RAUHWpx_STUDIO_DIST=/app/studio \
    RAUHWpx_AGENT_ROOT=/app/rhwp-agent \
    RAUHWpx_PROVIDER_CLI_PREFIX=/opt/rauhwpx-provider-cli \
    RAUHWpx_PI_PREFIX=/opt/rauhwpx-provider-cli \
    RHWP_BIN=/app/bin/rhwp \
    RAUHWpx_WORKER_ENTRY=/app/worker/main.mjs \
    RAUHWpx_RUNNER=local \
    RAUHWpx_WORKER_UID=1001 \
    RAUHWpx_WORKER_GID=1001 \
    RAUHWpx_WORKER_CONTROL_DIR=/run/rauhwpx \
    RAUHWpx_PROVIDER_CLI_DIR=/opt/rauhwpx-cloud/provider-cli \
    RAUHWpx_HOST=0.0.0.0 \
    RAUHWpx_PORT=7740 \
    RAUHWpx_DATA_DIR=/var/lib/rauhwpx-cloud \
    RAUHWpx_WORKSPACE_ROOT=/var/lib/rauhwpx-workspaces

EXPOSE 7740
ENTRYPOINT ["/usr/bin/tini", "--", "/app/install/sandbox-entrypoint.sh"]
