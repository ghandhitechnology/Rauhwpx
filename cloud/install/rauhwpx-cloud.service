[Unit]
Description=Rauhwpx durable cloud agent service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rauhwpx-cloud
Group=rauhwpx-cloud
EnvironmentFile=-/etc/rauhwpx-cloud.env
Environment=HOME=/var/lib/rauhwpx-cloud
Environment=XDG_RUNTIME_DIR=/run/rauhwpx-cloud
ExecStart=/opt/rauhwpx-node/bin/node /opt/rauhwpx-cloud/current/src/main.mjs
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s
KillMode=mixed
RuntimeDirectory=rauhwpx-cloud
RuntimeDirectoryMode=0700
StateDirectory=rauhwpx-cloud
StateDirectoryMode=0700
UMask=0077
# Rootless Podman needs newuidmap on a cold boot, and runc must mount its
# private proc filesystem. These two host-unit restrictions are incompatible
# with Podman 4.9; worker containers enforce their own stricter boundary.
NoNewPrivileges=no
Delegate=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/rauhwpx-cloud /run/rauhwpx-cloud
ProtectKernelTunables=no
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
SystemCallArchitectures=native
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
