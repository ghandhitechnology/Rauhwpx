{
  "name": "rauhwpx",
  "productName": "Rauhwpx",
  "version": "1.2.2",
  "description": "HWP/HWPX editor with a local Claude/Codex agent sidebar.",
  "author": "Hataewook",
  "license": "MIT",
  "homepage": "https://github.com/ghandhitechnology/Rauhwpx",
  "desktopName": "rauhwpx.desktop",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "main": "desktop/main.mjs",
  "scripts": {
    "start": "node rhwp/rhwp-agent/ctl.mjs start",
    "start:fg": "node rhwp/rhwp-agent/server.mjs",
    "stop": "node rhwp/rhwp-agent/ctl.mjs stop",
    "restart": "node rhwp/rhwp-agent/ctl.mjs restart",
    "status": "node rhwp/rhwp-agent/ctl.mjs status",
    "dev:desktop": "wait-on http://127.0.0.1:7700 && cross-env RHWP_DEV_URL=http://127.0.0.1:7700 electron .",
    "build:wasm": "wasm-pack build rhwp --target web",
    "build:native": "cargo build --manifest-path rhwp/Cargo.toml --release --locked --bin rhwp && node desktop/stage-native-rhwp.mjs",
    "build:studio:app": "npm --prefix rhwp/rhwp-studio ci && npm --prefix rhwp/rhwp-studio run build",
    "build:studio": "npm run build:wasm && npm run build:studio:app",
    "build:agent": "npm --prefix rhwp/rhwp-agent ci --omit=dev",
    "build:desktop": "npm run build:native && npm run build:studio && npm run build:agent",
    "desktop": "npm run build:desktop && electron .",
    "dist:mac": "npm run build:desktop && electron-builder --mac dmg zip --arm64 --publish never",
    "dist:win": "npm run build:desktop && electron-builder --win --publish never",
    "dist:linux": "npm run build:desktop && electron-builder --linux AppImage deb --publish never",
    "dist:linux:x64": "npm run build:desktop && electron-builder --linux AppImage deb --x64 --publish never",
    "dist:linux:arm64": "npm run build:desktop && electron-builder --linux AppImage deb --arm64 --publish never",
    "test:cloud": "node --test tests/desktop-cloud.test.mjs tests/desktop-cloud-display.test.mjs tests/desktop-cloud-protocol.test.mjs tests/desktop-cloud-client-reliability.test.mjs tests/desktop-cloud-connection-reliability.test.mjs tests/desktop-cloud-handoff-reliability.test.mjs tests/desktop-cloud-provisioner-recovery.test.mjs tests/desktop-provider-auth.test.mjs tests/desktop-app-servers.test.mjs tests/desktop-app-server-live.test.mjs tests/desktop-cloud-broker.test.mjs && npm --prefix cloud test",
    "check:cloud": "node --check desktop/cloud-*.mjs desktop/fs-replace.mjs && npm --prefix cloud run check",
    "check:raucloud-branding": "node scripts/check-raucloud-branding.mjs",
    "verify:package": "node scripts/verify-desktop-package.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "cross-env": "^10.1.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.hataewook.rauhwpx",
    "productName": "Rauhwpx",
    "artifactName": "Rauhwpx-${version}-${arch}.${ext}",
    "asar": true,
    "files": [
      "desktop/**/*",
      "cloud/install/install.sh",
      "cloud/install/install-macos.sh",
      "cloud/release/rauhwpx-cloud-bootstrap-linux-*.tar.gz",
      "rhwp/rhwp-studio/dist/**/*",
      "!rhwp/rhwp-studio/dist/samples/**",
      "rhwp/rhwp-agent/**/*",
      "!rhwp/rhwp-agent/tests/**",
      "!rhwp/rhwp-agent/README.md",
      "!rhwp/rhwp-agent/package-lock.json",
      "!rhwp/rhwp-agent/tsconfig.agents.json",
      "rhwp/rau-credits/catalog.mjs"
    ],
    "asarUnpack": [
      "rhwp/rhwp-agent/**",
      "desktop/bin/**",
      "cloud/install/install.sh",
      "cloud/install/install-macos.sh",
      "cloud/release/rauhwpx-cloud-bootstrap-linux-*.tar.gz",
      "rhwp/rau-credits/catalog.mjs"
    ],
    "extraResources": [
      {
        "from": "rhwp/target/release",
        "to": "bin",
        "filter": [
          "rhwp",
          "rhwp.exe"
        ]
      }
    ],
    "fileAssociations": [
      {
        "ext": [
          "hwp",
          "hwpx",
          "hml"
        ],
        "name": "Hangul document",
        "description": "Hangul word-processing document",
        "role": "Editor"
      },
      {
        "ext": [
          "rhwpx"
        ],
        "name": "Rauhwpx history archive",
        "description": "Rauhwpx history archive",
        "role": "Editor"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "publish": {
      "provider": "github",
      "owner": "ghandhitechnology",
      "repo": "Rauhwpx"
    },
    "electronLanguages": [
      "en",
      "ko"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "identity": "TAEWOOK HA (C8M34MMT8W)",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeExtensions": [
              "hwpx"
            ],
            "CFBundleTypeName": "HWPX document",
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Default",
            "LSItemContentTypes": [
              "com.hataewook.rauhwpx.hwpx-document"
            ]
          },
          {
            "CFBundleTypeExtensions": [
              "rhwpx"
            ],
            "CFBundleTypeName": "RauHWPX history archive",
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Default",
            "LSItemContentTypes": [
              "com.hataewook.rauhwpx.history-bundle"
            ]
          }
        ],
        "UTExportedTypeDeclarations": [
          {
            "UTTypeConformsTo": [
              "public.content",
              "public.data"
            ],
            "UTTypeDescription": "HWPX document",
            "UTTypeIdentifier": "com.hataewook.rauhwpx.hwpx-document",
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "hwpx"
              ]
            }
          },
          {
            "UTTypeConformsTo": [
              "public.content",
              "public.data"
            ],
            "UTTypeDescription": "RauHWPX history archive",
            "UTTypeIdentifier": "com.hataewook.rauhwpx.history-bundle",
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "rhwpx"
              ]
            }
          }
        ]
      },
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "rhwp/assets/logo/logo-512.png",
      "category": "Office",
      "synopsis": "HWP and HWPX document editor",
      "description": "Open, edit, and save Hangul HWP, HWPX, and HML documents with an integrated agent sidebar.",
      "executableName": "rauhwpx",
      "maintainer": "Rauhwpx maintainers <noreply@github.com>",
      "vendor": "ghandhitechnology",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "StartupWMClass": "Rauhwpx",
          "X-GNOME-UsesNotifications": "true"
        }
      }
    },
    "deb": {
      "packageName": "rauhwpx",
      "packageCategory": "editors",
      "depends": [
        "libgtk-3-0 | libgtk-3-0t64",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0 | libatspi2.0-0t64",
        "libuuid1",
        "libsecret-1-0"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "selectPerMachineByDefault": false,
      "allowElevation": true,
      "packElevateHelper": true,
      "allowToChangeInstallationDirectory": true
    },
    "dmg": {
      "title": "Rauhwpx",
      "backgroundColor": "#f5f5f7",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 150,
          "y": 190,
          "type": "file"
        },
        {
          "x": 390,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
