{
  "name": "rauhwpx",
  "productName": "Rauhwpx",
  "version": "1.0.0",
  "description": "HWP/HWPX editor with a local Claude/Codex agent sidebar.",
  "author": "Hataewook",
  "private": true,
  "main": "desktop/main.mjs",
  "scripts": {
    "start": "node rhwp/rhwp-agent/ctl.mjs start",
    "start:fg": "node rhwp/rhwp-agent/server.mjs",
    "stop": "node rhwp/rhwp-agent/ctl.mjs stop",
    "restart": "node rhwp/rhwp-agent/ctl.mjs restart",
    "status": "node rhwp/rhwp-agent/ctl.mjs status",
    "dev:desktop": "wait-on http://127.0.0.1:7700 && cross-env RHWP_DEV_URL=http://127.0.0.1:7700 electron .",
    "build:wasm": "wasm-pack build rhwp --target web",
    "build:studio": "npm run build:wasm && npm --prefix rhwp/rhwp-studio ci && npm --prefix rhwp/rhwp-studio run build",
    "build:agent": "npm --prefix rhwp/rhwp-agent ci --omit=dev",
    "desktop": "npm run build:studio && electron .",
    "dist:mac": "npm run build:studio && npm run build:agent && electron-builder --mac dmg zip --arm64 --publish never",
    "dist:win": "npm run build:studio && npm run build:agent && electron-builder --win --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.hataewook.rauhwpx",
    "productName": "Rauhwpx",
    "artifactName": "Rauhwpx-${version}-${arch}.${ext}",
    "asar": true,
    "files": [
      "desktop/**/*",
      "rhwp/rhwp-studio/dist/**/*",
      "rhwp/rhwp-agent/**/*",
      "rhwp/rhwp-agent/node_modules/**/*",
      "!rhwp/rhwp-agent/tests/**"
    ],
    "asarUnpack": [
      "rhwp/rhwp-agent/**"
    ],
    "fileAssociations": [
      {
        "ext": [
          "hwp",
          "hwpx",
          "hml",
          "rhwpx"
        ],
        "name": "Hangul document",
        "description": "Hangul word-processing document",
        "role": "Editor"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "publish": {
      "provider": "github",
      "owner": "ghandhitechnology",
      "repo": "Rauhwpx"
    },
    "electronLanguages": [
      "en",
      "ko"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "identity": "TAEWOOK HA (C8M34MMT8W)",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeExtensions": [
              "hwpx"
            ],
            "CFBundleTypeName": "HWPX document",
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Default",
            "LSItemContentTypes": [
              "com.hataewook.rauhwpx.hwpx-document"
            ]
          },
          {
            "CFBundleTypeExtensions": [
              "rhwpx"
            ],
            "CFBundleTypeName": "RauHWPX history bundle",
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Default",
            "LSItemContentTypes": [
              "com.hataewook.rauhwpx.history-bundle"
            ]
          }
        ],
        "UTExportedTypeDeclarations": [
          {
            "UTTypeConformsTo": [
              "public.content",
              "public.data"
            ],
            "UTTypeDescription": "HWPX document",
            "UTTypeIdentifier": "com.hataewook.rauhwpx.hwpx-document",
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "hwpx"
              ]
            }
          },
          {
            "UTTypeConformsTo": [
              "public.content",
              "public.data"
            ],
            "UTTypeDescription": "RauHWPX history bundle",
            "UTTypeIdentifier": "com.hataewook.rauhwpx.history-bundle",
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "rhwpx"
              ]
            }
          }
        ]
      },
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true
    },
    "dmg": {
      "title": "Rauhwpx",
      "backgroundColor": "#f5f5f7",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 150,
          "y": 190,
          "type": "file"
        },
        {
          "x": 390,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
