{
  "name": "rauhwpx",
  "productName": "Rauhwpx",
  "version": "1.2.2",
  "description": "HWP/HWPX editor with a local AI agent sidebar.",
  "author": "Hataewook",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "main": "desktop/main.mjs",
  "scripts": {
    "start": "node rhwp/rhwp-agent/ctl.mjs start",
    "start:fg": "node rhwp/rhwp-agent/server.mjs",
    "stop": "node rhwp/rhwp-agent/ctl.mjs stop",
    "restart": "node rhwp/rhwp-agent/ctl.mjs restart",
    "status": "node rhwp/rhwp-agent/ctl.mjs status",
    "check:docs": "node scripts/check-publish-docs.mjs",
    "dev:desktop": "wait-on http://127.0.0.1:7700 && cross-env RHWP_DEV_URL=http://127.0.0.1:7700 electron .",
    "build:wasm": "cd rhwp && wasm-pack build --target web",
    "build:native": "cd rhwp && cargo build --locked --release --bin rhwp",
    "build:studio:app": "npm --prefix rhwp/rhwp-studio run build",
    "build:studio": "npm run build:wasm && npm run build:studio:app",
    "build:desktop": "npm run build:native && npm run build:studio",
    "desktop": "electron .",
    "dist:mac": "npm run build:desktop && npm run package:mac --",
    "dist:win": "npm run build:desktop && npm run package:win --",
    "verify:package": "node scripts/verify-desktop-package.mjs",
    "setup": "npm ci && npm --prefix rhwp/rhwp-studio ci && npm --prefix rhwp/rhwp-agent ci",
    "build:clean": "npm run setup && npm run build:desktop",
    "package:mac": "electron-builder --mac dmg zip --arm64 --publish never",
    "package:win": "electron-builder --win --publish never",
    "test:ci": "node --test scripts/*.test.mjs",
    "audit:production": "node scripts/audit-production.mjs",
    "dev:studio": "npm --prefix rhwp/rhwp-studio run dev",
    "dev:sidebar": "npm --prefix rhwp/rhwp-studio run dev:sidebar",
    "test:sidebar": "npm --prefix rhwp/rhwp-studio run test:sidebar",
    "build:sidebar": "npm --prefix rhwp/rhwp-studio run build:sidebar"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "cross-env": "^10.1.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "wait-on": "^9.1.0",
    "js-yaml": "^4.3.1"
  },
  "build": {
    "appId": "com.hataewook.rauhwpx",
    "productName": "Rauhwpx",
    "artifactName": "Rauhwpx-${version}-${arch}.${ext}",
    "asar": true,
    "files": [
      "desktop/**/*",
      "rhwp/rhwp-studio/dist/**/*",
      "!rhwp/rhwp-studio/dist/samples/**",
      "rhwp/rhwp-agent/**/*",
      "!rhwp/rhwp-agent/tests/**",
      "!rhwp/rhwp-agent/README.md",
      "!rhwp/rhwp-agent/package-lock.json",
      "!rhwp/rhwp-agent/tsconfig.agents.json",
      "!rhwp/rhwp-agent/node_modules/.bin/tsc{,.cmd,.ps1}",
      "!rhwp/rhwp-agent/node_modules/typescript/**",
      "!rhwp/rhwp-agent/node_modules/@typescript/typescript-*/**",
      "rhwp/rau-credits/catalog.mjs"
    ],
    "asarUnpack": [
      "rhwp/rhwp-agent/**",
      "rhwp/rau-credits/catalog.mjs"
    ],
    "extraResources": [
      {
        "from": "rhwp/target/release",
        "to": "bin",
        "filter": [
          "rhwp",
          "rhwp.exe"
        ]
      }
    ],
    "fileAssociations": [
      {
        "ext": [
          "hwp",
          "hwpx",
          "hml"
        ],
        "name": "Hangul document",
        "description": "Hangul word-processing document",
        "role": "Editor"
      },
      {
        "ext": [
          "rhwpx"
        ],
        "name": "Rauhwpx history archive",
        "description": "Rauhwpx history archive",
        "role": "Editor"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "publish": {
      "provider": "github",
      "owner": "ghandhitechnology",
      "repo": "Rauhwpx"
    },
    "electronLanguages": [
      "en",
      "ko"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "identity": "TAEWOOK HA (C8M34MMT8W)",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeExtensions": [
              "hwpx"
            ],
            "CFBundleTypeName": "HWPX document",
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Default",
            "LSItemContentTypes": [
              "com.hataewook.rauhwpx.hwpx-document"
            ]
          },
          {
            "CFBundleTypeExtensions": [
              "rhwpx"
            ],
            "CFBundleTypeName": "RauHWPX history archive",
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Default",
            "LSItemContentTypes": [
              "com.hataewook.rauhwpx.history-bundle"
            ]
          }
        ],
        "UTExportedTypeDeclarations": [
          {
            "UTTypeConformsTo": [
              "public.content",
              "public.data"
            ],
            "UTTypeDescription": "HWPX document",
            "UTTypeIdentifier": "com.hataewook.rauhwpx.hwpx-document",
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "hwpx"
              ]
            }
          },
          {
            "UTTypeConformsTo": [
              "public.content",
              "public.data"
            ],
            "UTTypeDescription": "RauHWPX history archive",
            "UTTypeIdentifier": "com.hataewook.rauhwpx.history-bundle",
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "rhwpx"
              ]
            }
          }
        ]
      },
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "selectPerMachineByDefault": false,
      "allowElevation": true,
      "packElevateHelper": true,
      "allowToChangeInstallationDirectory": true
    },
    "dmg": {
      "title": "Rauhwpx",
      "backgroundColor": "#f5f5f7",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 150,
          "y": 190,
          "type": "file"
        },
        {
          "x": 390,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
