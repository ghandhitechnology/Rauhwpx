{
  "name": "rhwp-agent",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node server.mjs",
    "start:bg": "node ctl.mjs start",
    "stop": "node ctl.mjs stop",
    "status": "node ctl.mjs status",
    "test": "node --test tests/*.test.mjs",
    "test:browserbase:live": "node tests/browserbase-live-smoke.mjs",
    "typecheck": "npm run typecheck:acp",
    "typecheck:acp": "tsc -p tsconfig.agents.json",
    "postinstall": "node scripts/prepare-terminal.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.241",
    "@browserbasehq/stagehand": "4.0.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@sinclair/typebox": "^0.34.0",
    "cross-spawn": "^7.0.6",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.1",
    "node-pty": "1.1.0",
    "npm": "11.19.1",
    "pdfjs-dist": "^4.10.38",
    "ws": "^8.21.2",
    "zod": "4.4.3",
    "zod-to-json-schema": "^3.24.0"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.15",
    "fast-uri": "3.1.7",
    "qs": "6.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "node-pty": true
  }
}
