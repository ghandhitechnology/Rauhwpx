{
  "name": "rhwp-studio",
  "version": "0.8.2",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "agent": "node ../rhwp-agent/server.mjs",
    "subsecond:install": "cargo install dioxus-cli --version 0.7.9 --locked --root ../target/dioxus-cli",
    "subsecond:serve": "cd .. && target/dioxus-cli/bin/dx serve --web --package rhwp-subsecond --features subsecond-dev --hot-patch --port 7711 --addr 127.0.0.1 --open false --interactive false --inject-loading-scripts false",
    "subsecond:sync": "mkdir -p ../target/rhwp-subsecond-vite && cp ../target/dx/rhwp-subsecond/debug/web/public/wasm/rhwp-subsecond.js ../target/dx/rhwp-subsecond/debug/web/public/wasm/rhwp-subsecond_bg.wasm ../target/rhwp-subsecond-vite/",
    "dev:subsecond": "npm run subsecond:sync && RHWP_SUBSECOND=1 vite",
    "generate:agent-edit-capabilities": "node scripts/generate-agent-edit-capabilities.mjs",
    "build": "npm run generate:agent-edit-capabilities && tsc && vite build",
    "preview": "vite preview",
    "test": "npm run generate:agent-edit-capabilities && node scripts/run-tests.mjs unit",
    "e2e": "node e2e/text-flow.test.mjs",
    "e2e:cloud-onboarding": "node e2e/cloud-onboarding.test.mjs",
    "e2e:cloud-workspace": "node e2e/cloud-workspace.test.mjs",
    "e2e:cloud-display": "node e2e/cloud-display-interaction.test.mjs",
    "e2e:agent-edit-loop": "node e2e/agent-edit-loop.test.mjs --mode=headless",
    "e2e:user-question": "node e2e/user-question-flow.test.mjs --mode=headless",
    "e2e:subagent-fleet": "node e2e/subagent-fleet.test.mjs --mode=headless",
    "e2e:provider-fleets": "node e2e/provider-subagent-fleet.test.mjs --mode=headless",
    "e2e:codex-fleet": "node e2e/provider-subagent-fleet.test.mjs --mode=headless --provider=codex",
    "e2e:grok-fleet": "node e2e/provider-subagent-fleet.test.mjs --mode=headless --provider=grok",
    "e2e:cursor-fleet": "node e2e/provider-subagent-fleet.test.mjs --mode=headless --provider=cursor",
    "e2e:agent-settings-reconnect": "node e2e/agent-settings-reconnect.test.mjs --mode=headless",
    "e2e:agent-tool-bench": "node e2e/agent-tool-bench.mjs --mode=headless",
    "e2e:reference-files": "node e2e/reference-files-flow.test.mjs --mode=headless",
    "e2e:form-edit-escape": "node e2e/form-edit-escape-cancel.test.mjs --mode=headless",
    "e2e:inline-prompt": "node e2e/inline-prompt.test.mjs --mode=headless",
    "e2e:unsaved-guard": "node e2e/unsaved-changes-guard.test.mjs",
    "e2e:undo": "node e2e/undo-contracts.test.mjs",
    "e2e:undo-object-selection": "node e2e/undo-object-selection.test.mjs",
    "e2e:contextual-toolbar": "node e2e/contextual-editing-toolbar.test.mjs --mode=headless",
    "e2e:clipboard-priority": "node e2e/task-871-clipboard-priority.test.mjs",
    "e2e:editor-interactions": "node e2e/editor-table-interactions.test.mjs",
    "e2e:drag-autoscroll": "node e2e/drag-selection-autoscroll.test.mjs",
    "e2e:page-break-caret": "node e2e/page-break-caret-reveal.test.mjs --mode=headless",
    "e2e:drop-table-picture": "node e2e/drop-image-table-cell.test.mjs --mode=headless",
    "e2e:issue-4121": "node e2e/header-footer-selection-issue4121.test.mjs --mode=headless",
    "e2e:renderer-contract": "node e2e/renderer-contract.test.mjs",
    "e2e:issue-2214": "node e2e/issue-2214-page-local-repaint.test.mjs --mode=headless",
    "e2e:issue-2809": "node e2e/issue-2809-split-alignment.test.mjs --mode=headless",
    "e2e:canvaskit-font-coverage": "node e2e/canvaskit-font-coverage.test.mjs",
    "e2e:embed": "node e2e/embed-transport.test.mjs --mode=headless",
    "e2e:baseline:headless": "node e2e/renderer-baseline.mjs --mode=headless --manifest=../scripts/renderer_baseline_manifest.json --output=../output/renderer-baseline/studio-headless",
    "e2e:render-diff": "node e2e/canvas-render-diff.test.mjs --mode=headless",
    "e2e:long-document-image-cache": "node e2e/long-document-image-cache.mjs --mode=headless",
    "e2e:canvaskit-image-cache": "node e2e/canvaskit-image-cache-budget.mjs --mode=headless",
    "e2e:pdf-render-diff": "node e2e/pdf-render-diff-report.mjs --mode=headless",
    "e2e:render-diff:ci": "node e2e/run-render-diff.mjs",
    "test:browser": "node scripts/run-tests.mjs browser",
    "e2e:list": "python3 ../scripts/check_e2e_manifest.py --list",
    "e2e:check": "python3 ../scripts/check_e2e_manifest.py",
    "dev:sidebar": "vite --config vite.sidebar.config.ts",
    "build:sidebar": "vite build --config vite.sidebar.config.ts",
    "test:sidebar": "node sidebar-preview/check.mjs",
    "test:sidebar:audit": "node sidebar-preview/audit.check.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.2",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^25.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.1"
  },
  "overrides": {
    "serialize-javascript": "7.0.5"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "canvaskit-wasm": "^0.41.1",
    "katex": "^0.16.47"
  }
}
