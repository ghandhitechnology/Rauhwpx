{
  "services": [
    {
      "name": "studio",
      "cmd": "npm run dev",
      "cwd": "rhwp/rhwp-studio",
      "port": 7700,
      "match": "vite",
      "health": "/",
      "https_port": 8443,
      "env": {
        "RHWP_PUBLIC_HOST": "${TS_DNSNAME}",
        "RHWP_PUBLIC_HTTPS_PORT": "${HTTPS_PORT}",
        "VITE_RHWP_AGENT_URL": "wss://${TS_DNSNAME}:8444"
      }
    },
    {
      "name": "agent-hub",
      "cmd": "npm start",
      "cwd": "rhwp/rhwp-agent",
      "port": 5175,
      "match": "server.mjs",
      "health": "/healthz",
      "https_port": 8444,
      "env": {
        "RHWP_AGENT_TOKEN": "dev"
      }
    }
  ],
  "prerequisites": [
    {
      "type": "require-marker",
      "file": "rhwp/rhwp-studio/vite.config.ts",
      "marker": "RHWP_PUBLIC_HOST",
      "hint": "vite.config.ts 에 RHWP_PUBLIC_HOST 블록(allowedHosts + wss HMR dial-back) 추가"
    }
  ]
}
